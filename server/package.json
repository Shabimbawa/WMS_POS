    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "postgres": "^3.4.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  }
